    "summary": "Rounds half to even at a number of places, treating a difference within 1e-9 of a half as a tie.",
    "operations": [
     {
      "name": "roundHalfEven",
      "signature": "roundHalfEven(value, places = 2)",
      "lines": "3-13",
      "does": "Rounds half to even.",
      "purity": "pure"
     }
    ],
    "rules": [
     {
      "statement": "A tie rounds to the even neighbour.",
      "formula": "floor % 2 === 0 ? floor : floor + 1",
      "lines": "10"
     },
     {
      "statement": "A tie is a difference within epsilon of 0.5.",
      "formula": "Math.abs(diff - 0.5) < epsilon",
      "lines": "8-9"
     },
     {
      "statement": "Otherwise it rounds as Math.round does.",
      "formula": "Math.round(scaled) / factor",
      "lines": "12"
     }
