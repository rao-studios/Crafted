   "purpose": "engineer.unit",
   "match": "The unit: Rounding\n",
   "text": "```swift\nimport Foundation\n\n/// Half-to-even rounding as src/round.js does it: a difference within 1e-9 of a half is a tie, and a tie goes to the\n/// even neighbour; anything else rounds as JavaScript's Math.round (half up, toward positive infinity).\npublic enum Rounding: RoundingContract {\n    public static func halfEven(value: Double, places: Int) throws -> Double {\n        let factor = pow(10.0, Double(places))\n        let scaled = value * factor\n        let floor = scaled.rounded(.down)\n        let diff = scaled - floor\n        if abs(diff - 0.5) < 1e-9 {\n            let even = floor.truncatingRemainder(dividingBy: 2) == 0 ? floor : floor + 1\n            return even / factor\n        }\n        return (scaled + 0.5).rounded(.down) / factor\n    }\n}\n```"
  },
  {
   "purpose": "engineer.unit",
   "match": "The unit: InvoiceMath\n",
   "text": "```swift\nimport Foundation\n\n/// The invoice arithmetic of src/invoice.js, every amount to the cent, half to even.\npublic enum InvoiceMath: InvoiceMathContract {\n    public static func rates() throws -> [String: Double] {\n        try CoreResources.json([String: Double].self, \"rates.json\")\n    }\n\n    public static func lineAmount(line: InvoiceLine) throws -> Double {\n        guard line.quantity >= 0, line.unitPrice >= 0 else {\n            throw CoreFailure.invalid(\"quantity and unit price must not be negative: \\(line.description) has \\(line.quantity) at \\(line.unitPrice).\")\n        }\n        return try Rounding.halfEven(value: line.quantity * line.unitPrice, places: 2)\n    }\n\n    public static func subtotal(lines: [InvoiceLine]) throws -> Double {\n        var sum = 0.0\n        for line in lines { sum += try lineAmount(line: line) }\n        return try Rounding.halfEven(value: sum, places: 2)\n    }\n\n    public static func discountAmount(subtotal: Double, discount: Discount?) throws -> Double {\n        guard let discount else { return 0 }\n        if let percent = discount.percent {\n            return try Rounding.halfEven(value: subtotal * percent / 100, places: 2)\n        }\n        return min(try Rounding.halfEven(value: discount.amount ?? 0, places: 2), subtotal)\n    }\n\n    public static func taxRate(region: String) throws -> Double {\n        let table = try rates()\n        guard let rate = table[region] else {\n            throw CoreFailure.invalid(\"no tax rate for region \\(region): use \" + table.keys.sorted().joined(separator: \", \") + \".\")\n        }\n        return rate\n    }\n\n    public static func totals(invoice: Invoice, region: String) throws -> InvoiceTotals {\n        let sub = try subtotal(lines: invoice.lines)\n        let discount = try discountAmount(subtotal: sub, discount: invoice.discount)\n        let taxable = try Rounding.halfEven(value: sub - discount, places: 2)\n        let tax = try Rounding.halfEven(value: taxable * taxRate(region: region), places: 2)\n        return InvoiceTotals(subtotal: sub, discount: discount, taxable: taxable, tax: tax, total: try Rounding.halfEven(value: taxable + tax, places: 2))\n    }\n}\n```"
  },
  {
   "purpose": "engineer.handler",
   "match": "The command: total\n",
   "text": "```swift\nimport Foundation\n\n/// `total`: an invoice file's totals as facts, and the invoice as a report.\nenum TotalHandler: CommandHandler {\n    static func run(_ arguments: TotalArguments, _ kit: CommandKit) async throws -> [Product] {\n        let text = try kit.text(arguments.invoice)\n        let invoice: Invoice\n        do {\n            invoice = try JSONDecoder().decode(Invoice.self, from: Data(text.utf8))\n        } catch {\n            throw CoreFailure.invalid(\"\\(arguments.invoice) is not an invoice: give JSON with `lines` of description, quantity and unitPrice.\")\n        }\n        let region = arguments.region ?? \"CA\"\n        let totals = try InvoiceMath.totals(invoice: invoice, region: region)\n        let rows = try invoice.lines.map { line in\n            [line.description, FactValue.format(line.quantity), FactValue.format(line.unitPrice), FactValue.format(try InvoiceMath.lineAmount(line: line))]\n        }\n        let report = Report(name: \"invoice\", title: \"Invoice totals\", subtitle: \"\\(invoice.lines.count) lines, \\(region) sales tax\", blocks: [\n            .table(columns: [\"item\", \"quantity\", \"unit price\", \"amount\"], rows: rows),\n            .facts([Fact(\"subtotal\", .number(totals.subtotal)), Fact(\"discount\", .number(totals.discount)), Fact(\"tax\", .number(totals.tax)),\n                    Fact(\"total\", .number(totals.total))]),\n            .note(\"Every amount is rounded half to even to the cent.\"),\n        ])\n        return [\n            .value(\"subtotal\", totals.subtotal), .value(\"discount\", totals.discount), .value(\"taxable\", totals.taxable),\n            .value(\"tax\", totals.tax), .value(\"total\", totals.total), .report(report),\n            .say(\"The invoice comes to \\(FactValue.format(totals.total)) with \\(region) tax of \\(FactValue.format(totals.tax)).\"),\n        ]\n    }\n}\n```"
  },
  {
   "purpose": "engineer.handler",
   "match": "The command: rates\n",
   "text": "```swift\nimport Foundation\n\n/// `rates`: every region's sales-tax rate as a table.\nenum RatesHandler: CommandHandler {\n    static func run(_ arguments: RatesArguments, _ kit: CommandKit) async throws -> [Product] {\n        let rates = try InvoiceMath.rates()\n        let rows = rates.keys.sorted().map { [$0, FactValue.format(rates[$0] ?? 0)] }\n        return [.value(\"regions\", rows.count), .csv(\"rates\", columns: [\"region\", \"rate\"], rows: rows), .say(\"\\(rows.count) regions have a rate.\")]\n    }\n}\n```"
  },
  {
   "purpose": "engineer.handler",
   "match": "The command: round\n",
   "text": "```swift\nimport Foundation\n\n/// `round`: one amount, rounded half to even.\nenum RoundHandler: CommandHandler {\n    static func run(_ arguments: RoundArguments, _ kit: CommandKit) async throws -> [Product] {\n        let places = arguments.places ?? 2\n        guard (0...10).contains(places) else { throw CoreFailure.invalid(\"\\(places) places is out of range: give 0 to 10.\") }\n        let rounded = try Rounding.halfEven(value: arguments.value, places: places)\n        return [.value(\"rounded\", rounded), .say(\"\\(FactValue.format(arguments.value)) rounds half to even to \\(FactValue.format(rounded)).\")]\n    }\n}\n```"
