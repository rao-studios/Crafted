   "purpose": "engineer.unit",
   "match": "The unit: Readability\n",
   "text": "```swift\nimport Foundation\n\n/// The scores through the lifted TextStats (Lifted/TextStats.swift), as the source computes them.\npublic enum Readability: ReadabilityContract {\n    public static func measure(text: String) throws -> TextMeasure {\n        let stats = TextStats(text)\n        return TextMeasure(words: stats.words, sentences: stats.sentences, syllables: stats.syllables,\n                           readingEase: stats.readingEase, grade: stats.grade, minutes: stats.minutes)\n    }\n\n    public static func syllables(word: String) throws -> Int {\n        TextStats.syllables(in: word.lowercased())\n    }\n}\n```"
  },
  {
   "purpose": "engineer.handler",
   "match": "The command: measure\n",
   "text": "```swift\nimport Foundation\n\n/// `measure`: a text's counts and scores as facts, and as a report.\nenum MeasureHandler: CommandHandler {\n    static func run(_ arguments: MeasureArguments, _ kit: CommandKit) async throws -> [Product] {\n        let text: String\n        if let given = arguments.text {\n            text = given\n        } else if let file = arguments.file {\n            text = try kit.text(file)\n        } else {\n            throw CoreFailure.invalid(\"Give `text`, or a `file` in the project, to measure.\")\n        }\n        let measure = try Readability.measure(text: text)\n        let ease = (measure.readingEase * 10).rounded() / 10\n        let grade = (measure.grade * 10).rounded() / 10\n        let report = Report(name: \"readability\", title: \"Readability\", subtitle: \"\\(measure.words) words in \\(measure.sentences) sentences\", blocks: [\n            .facts([Fact(\"reading ease\", .number(ease)), Fact(\"grade\", .number(grade)), Fact(\"minutes\", .number((measure.minutes * 10).rounded() / 10))]),\n            .bars(title: \"Counts\", items: [ReportBar(\"words\", Double(measure.words)), ReportBar(\"sentences\", Double(measure.sentences)),\n                                           ReportBar(\"syllables\", Double(measure.syllables))]),\n            .note(\"Flesch reading ease: higher is easier. The grade is a school grade.\"),\n        ])\n        return [\n            .value(\"words\", measure.words), .value(\"sentences\", measure.sentences), .value(\"syllables\", measure.syllables),\n            .value(\"readingEase\", ease), .value(\"grade\", grade), .value(\"minutes\", measure.minutes, unit: \"min\"), .report(report),\n            .say(\"Reading ease \\(FactValue.format(ease)), grade \\(FactValue.format(grade)).\"),\n        ]\n    }\n}\n```"
  },
