   "purpose": "engineer.handler",
   "match": "The command: syllables\n",
   "text": "```swift\nimport Foundation\n\n/// `syllables`: one word's syllables.\nenum SyllablesHandler: CommandHandler {\n    static func run(_ arguments: SyllablesArguments, _ kit: CommandKit) async throws -> [Product] {\n        let count = try Readability.syllables(word: arguments.word)\n        return [.value(\"count\", count), .say(\"\\(arguments.word) has \\(count) syllable\\(count == 1 ? \"\" : \"s\").\")]\n    }\n}\n```"
