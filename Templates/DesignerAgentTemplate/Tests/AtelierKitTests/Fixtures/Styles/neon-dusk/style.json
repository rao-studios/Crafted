      {"id": "B", "hex": "#F4F1FF", "name": "moon", "weight": 0.2},
      {"id": "C", "hex": "#FF4FA3", "name": "neon pink", "weight": 0.12},
      {"id": "D", "hex": "#33E1FF", "name": "cyan", "weight": 0.08},
      {"id": "E", "hex": "#1C1736", "name": "dusk", "weight": 0.05},
